# ABE-RAG service environment variables
# Copy to .env.local (git-ignored) or set them in the SAME shell that starts the Java service.

# --- required: embedding provider (OpenAI compatible /v1/embeddings) ---
# Aliyun DashScope: https://dashscope.aliyuncs.com/compatible-mode
ABE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
ABE_RAG_EMBEDDING_API_KEY=sk-replace-me
ABE_EMBEDDING_MODEL=text-embedding-v4
ABE_EMBEDDING_DIMENSIONS=1024

# --- required: chat provider (DeepSeek, OpenAI compatible) ---
# DeepSeek official: https://api.deepseek.com
ABE_CHAT_BASE_URL=https://api.deepseek.com
ABE_RAG_CHAT_API_KEY=sk-replace-me
ABE_CHAT_MODEL=deepseek-chat

# --- corpus and collection ---
ABE_CORPUS_DIR=D:/ABE-Program/module-a-rag/docs
QDRANT_COLLECTION=abe_knowledge
ABE_RAG_INCLUDE_QA=false

# --- dev gates: enable only while ingesting ---
# ingest needs BOTH switches for the first full rebuild:
#   ABE_RAG_INGEST_ENABLED=true  ABE_RAG_ALLOW_RECREATE=true
# after the first rebuild set ABE_RAG_ALLOW_RECREATE=false
ABE_RAG_INGEST_ENABLED=true
ABE_RAG_ALLOW_RECREATE=false
